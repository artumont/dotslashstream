# Development image with hot reload via Air
FROM golang:1.25-alpine

RUN apk add --no-cache git python3

# Install Air for hot reload
RUN go install github.com/air-verse/air@v1.65.3

WORKDIR /src

# Cache deps
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Generate registry
RUN python3 scripts/gen_registry.py

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
